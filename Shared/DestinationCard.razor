@* Shared/DestinationCard.razor *@
@* Reusable card used on Index.razor AND Destinations.razor *@
@* Usage: <DestinationCard Destination="dest" OnFavoriteToggle="HandleToggle" IsFavorite="true" /> *@

@using DunesOfArabia.Models

<style>
    .dest-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(90,55,35,0.07);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        display: flex;
        flex-direction: column;
    }

    .dest-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(90,55,35,0.14);
    }

    .card-img-wrap { position: relative; flex-shrink: 0; }

    .card-img-wrap img {
        width: 100%;
        height: 210px;
        object-fit: cover;
        display: block;
    }

    .bookmark-btn {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 34px;
        height: 34px;
        background: white;
        border: none;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 2px 6px rgba(0,0,0,0.14);
        transition: background 0.2s, transform 0.15s;
    }

    .bookmark-btn:hover { background: #f5f0eb; transform: scale(1.1); }

    .category-tag {
        position: absolute;
        bottom: 12px;
        left: 12px;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 600;
        background: rgba(46,26,14,0.75);
        color: #C8873A;
        letter-spacing: 0.5px;
    }

    .card-body {
        padding: 1.2rem 1.3rem 1.4rem;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .card-name-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.3rem;
    }

    .card-name {
        font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
        font-size: 1.15rem;
        color: #2E1A0E;
        font-weight: 700;
    }

    .card-rating {
        display: flex;
        align-items: center;
        gap: 3px;
        font-size: 0.87rem;
        color: #2E1A0E;
        font-weight: 600;
    }

    .star { color: #C8873A; }

    .card-location {
        display: flex;
        align-items: center;
        gap: 5px;
        color: #7A6658;
        font-size: 0.81rem;
        margin-bottom: 0.6rem;
    }

    .card-cost {
        font-size: 0.82rem;
        color: #7B3121;
        font-weight: 600;
        margin-bottom: 0.6rem;
    }

    .card-desc {
        color: #5A4A3A;
        font-size: 0.85rem;
        line-height: 1.55;
        margin-bottom: 1rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex: 1;
    }

    .btn-explore {
        display: block;
        width: 100%;
        padding: 10px;
        background: transparent;
        color: #7B3121;
        border: 1.5px solid #C4A090;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        transition: background 0.2s, border-color 0.2s, color 0.2s;
        font-family: 'Lato', sans-serif;
    }

    .btn-explore:hover {
        background: #7B3121;
        border-color: #7B3121;
        color: white;
    }
</style>

<div class="dest-card">
    <div class="card-img-wrap">
        <img src="@Destination.ImageUrl"
             alt="@Destination.Name"
             onerror="this.src='https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600'" />

        <!-- Bookmark button -->
        <button class="bookmark-btn"
                aria-label="@(IsFavorite ? "Remove from favorites" : "Save to favorites")"
                @onclick="HandleFavoriteClick">
            <svg width="15" height="15" viewBox="0 0 24 24"
                 fill="@(IsFavorite ? "#7B3121" : "none")"
                 stroke="@(IsFavorite ? "#7B3121" : "#7A6658")"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
        </button>

        <span class="category-tag">@Destination.Category</span>
    </div>

    <div class="card-body">
        <div class="card-name-row">
            <span class="card-name">@Destination.Name</span>
            <span class="card-rating">
                <span class="star">★</span>
                @Destination.Rating.ToString("0.0")
            </span>
        </div>

        <div class="card-location">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
            </svg>
            @Destination.Province
        </div>

        <div class="card-cost">From SAR @Destination.Cost.ToString("N0")</div>

        <p class="card-desc">@Destination.Description</p>

        <a href="/destinations/@Destination.Id" class="btn-explore">Explore →</a>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Destination Destination { get; set; } = default!;

    [Parameter]
    public bool IsFavorite { get; set; } = false;

    [Parameter]
    public EventCallback<int> OnFavoriteToggle { get; set; }

    private async Task HandleFavoriteClick()
    {
        await OnFavoriteToggle.InvokeAsync(Destination.Id);
    }
}
