@page "/destinations"
@layout DunesOfArabia.Components.Layout.MainLayout
@rendermode InteractiveServer

@inject IDestinationService DestinationService
@inject IUserFavoriteService UserFavoriteService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Destinations – Saudi Heritage</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@@400;600;700&family=Lato:wght@@300;400;500;600&display=swap');

    .dest-page {
        background-color: #F5EFE8;
        min-height: 100vh;
        font-family: 'Lato', sans-serif;
        display: flex;
        flex-direction: column;
        padding: 1.5rem;
        gap: 1rem;
        overflow-y: auto;
    }

    .top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .top-bar-left h1 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.75rem;
        color: #1C1008;
        font-weight: 700;
        line-height: 1.1;
        margin-bottom: 0.15rem;
    }

    .top-bar-left p {
        font-size: 0.82rem;
        color: #8A7566;
        font-weight: 300;
        margin: 0;
    }

    .controls-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .search-wrap {
        flex: 1;
        min-width: 220px;
        position: relative;
    }

    .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #9A8878;
        display: flex;
        align-items: center;
        pointer-events: none;
    }

    .search-input {
        width: 100%;
        padding: 10px 14px 10px 38px;
        border: 1.5px solid #DDD3C8;
        border-radius: 8px;
        font-size: 0.85rem;
        font-family: inherit;
        background: white;
        color: #2E1A0E;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
        box-shadow: 0 1px 4px rgba(90,55,35,0.04);
    }

    .search-input::placeholder { color: #B0A090; }
    .search-input:focus { border-color: #7B3121; box-shadow: 0 0 0 3px rgba(123,49,33,0.08); }

    .sort-wrap {
        display: flex;
        align-items: center;
        gap: 6px;
        background: white;
        border: 1.5px solid #DDD3C8;
        border-radius: 8px;
        padding: 8px 12px;
        white-space: nowrap;
        box-shadow: 0 1px 4px rgba(90,55,35,0.04);
    }

    .sort-select {
        border: none;
        outline: none;
        font-size: 0.83rem;
        font-family: inherit;
        color: #2E1A0E;
        background: transparent;
        cursor: pointer;
    }

    .filter-row {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .filter-btn {
        padding: 7px 18px;
        border-radius: 6px;
        font-size: 0.82rem;
        font-weight: 500;
        font-family: inherit;
        cursor: pointer;
        transition: background 0.18s, color 0.18s, border-color 0.18s;
        border: 1.5px solid #C4A090;
        background: white;
        color: #5A3A2A;
    }

    .filter-btn:hover  { border-color: #7B3121; color: #7B3121; }
    .filter-btn.active { background: #7B3121; border-color: #7B3121; color: white; }

    .error-banner {
        background: #FFF0EE;
        border: 1.5px solid #E8A090;
        border-radius: 8px;
        padding: 0.85rem 1rem;
        color: #7B2010;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .results-count {
        font-size: 0.82rem;
        color: #9A8878;
        text-align: center;
        padding: 1rem 0 0.5rem;
    }

    .destinations-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.1rem;
    }

    .dest-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 1px 8px rgba(90,55,35,0.07);
        transition: transform 0.22s, box-shadow 0.22s;
        display: flex;
        flex-direction: column;
    }

    .dest-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 26px rgba(90,55,35,0.13);
    }

    .card-img-wrap {
        position: relative;
        overflow: hidden;
    }

    .card-img-wrap img {
        width: 100%;
        height: 195px;
        object-fit: cover;
        display: block;
        transition: transform 0.4s ease;
    }

    .dest-card:hover .card-img-wrap img { transform: scale(1.04); }

    .card-category-badge {
        position: absolute;
        bottom: 10px;
        left: 10px;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.70rem;
        font-weight: 700;
        letter-spacing: 0.3px;
        background: rgba(255,255,255,0.92);
        color: #7B3121;
    }

    .bookmark-btn {
        position: absolute;
        top: 9px;
        right: 9px;
        width: 32px;
        height: 32px;
        background: rgba(255,255,255,0.92);
        border: none;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 1px 5px rgba(0,0,0,0.12);
        transition: background 0.2s, transform 0.15s;
    }

    .bookmark-btn:hover { background: white; transform: scale(1.1); }

    .card-body { padding: 1.1rem 1.2rem 1.2rem; flex: 1; display: flex; flex-direction: column; }

    .card-top-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 0.25rem;
        gap: 0.5rem;
    }

    .card-name {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.1rem;
        color: #1C1008;
        font-weight: 700;
        line-height: 1.2;
    }

    .card-rating {
        display: flex;
        align-items: center;
        gap: 3px;
        font-size: 0.83rem;
        color: #1C1008;
        font-weight: 700;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .star { color: #C8873A; }

    .card-location {
        display: flex;
        align-items: center;
        gap: 4px;
        color: #9A8878;
        font-size: 0.77rem;
        margin-bottom: 0.65rem;
    }

    .card-desc {
        color: #5A4A3A;
        font-size: 0.81rem;
        line-height: 1.55;
        margin-bottom: 1rem;
        flex: 1;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* ── FIXED: only Explore button — no direct Book Now here.
       The correct flow is: Destinations → Explore → DestinationDetails → Plan Trip → Checkout ── */
    .btn-explore {
        display: block;
        width: 100%;
        padding: 11px;
        text-align: center;
        font-size: 0.84rem;
        font-weight: 600;
        color: #7B3121;
        border: 1.5px solid #C8A882;
        border-radius: 7px;
        text-decoration: none;
        font-family: inherit;
        background: transparent;
        cursor: pointer;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
        margin-top: auto;
    }

    .btn-explore:hover { background: #7B3121; color: white; border-color: #7B3121; }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: white;
        border-radius: 12px;
        margin-bottom: 0.5rem;
    }

    .empty-icon { font-size: 2.5rem; margin-bottom: 0.75rem; }

    .empty-state h3 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.2rem;
        color: #2E1A0E;
        margin-bottom: 0.4rem;
    }

    .empty-state p { color: #7A6658; font-size: 0.87rem; }

    .skeleton-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.1rem; }
    .skel-card  { background: white; border-radius: 12px; overflow: hidden; }
    .skel-img   { width: 100%; height: 195px; background: #EEE8DF; animation: shimmer 1.4s infinite; }
    .skel-body  { padding: 1.1rem 1.2rem; }
    .skel-line  { height: 12px; background: #EEE8DF; border-radius: 5px; margin-bottom: 9px; animation: shimmer 1.4s infinite; }
    .skel-line.short { width: 55%; }
    .skel-line.btn   { height: 36px; margin-top: 12px; }

    @@keyframes shimmer {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.45; }
    }

    @@media (max-width: 1100px) {
        .destinations-grid, .skeleton-grid { grid-template-columns: repeat(2,1fr); }
    }

    @@media (max-width: 768px) {
        .dest-page { padding: 1rem; }
        .destinations-grid, .skeleton-grid { grid-template-columns: 1fr; }
        .controls-row { flex-wrap: wrap; }
    }
</style>

<div class="dest-page">

    <div class="top-bar">
        <div class="top-bar-left">
            <h1>Explore Saudi Arabia</h1>
            <p>Discover breathtaking destinations across the Kingdom</p>
        </div>
    </div>

    <div class="controls-row">
        <div class="search-wrap">
            <span class="search-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"/>
                    <path d="M21 21l-4.35-4.35"/>
                </svg>
            </span>
            <label for="searchInput" class="visually-hidden">Search destinations</label>
            <input id="searchInput"
                   class="search-input"
                   type="search"
                   placeholder="Search destinations, regions..."
                   @bind="searchQuery"
                   @bind:event="oninput"
                   @bind:after="RefreshDisplayed" />
        </div>

        <div class="sort-wrap">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#7A6658" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="21" y1="10" x2="3" y2="10"/>
                <line x1="21" y1="6"  x2="3" y2="6"/>
                <line x1="21" y1="14" x2="3" y2="14"/>
                <line x1="21" y1="18" x2="3" y2="18"/>
            </svg>
            <label for="sortSelect" class="visually-hidden">Sort by</label>
            <select id="sortSelect" class="sort-select" @bind="sortOrder" @bind:after="RefreshDisplayed">
                <option value="popular">Most Popular</option>
                <option value="rating_desc">Top Rated</option>
                <option value="name_asc">A – Z</option>
                <option value="name_desc">Z – A</option>
            </select>
        </div>
    </div>

    <div class="filter-row" role="group" aria-label="Filter by category">
        @foreach (var cat in Categories)
        {
            var isActive = selectedCategory == cat.Value;
            <button class="filter-btn @(isActive ? "active" : "")"
                    aria-pressed="@isActive.ToString().ToLower()"
                    @onclick="() => SetCategory(cat.Value)">
                @cat.Label
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-banner" role="alert">
            ⚠️ @errorMessage
        </div>
    }

    @if (isLoading)
    {
        <div class="skeleton-grid" aria-label="Loading destinations" aria-busy="true">
            @for (int i = 0; i < 9; i++)
            {
                <div class="skel-card">
                    <div class="skel-img"></div>
                    <div class="skel-body">
                        <div class="skel-line"></div>
                        <div class="skel-line short"></div>
                        <div class="skel-line"></div>
                        <div class="skel-line btn"></div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        @if (!displayedDestinations.Any())
        {
            <div class="empty-state">
                <div class="empty-icon" aria-hidden="true">🔍</div>
                <h3>No destinations found</h3>
                <p>Try adjusting your search or clearing the filters.</p>
            </div>
        }

        <div class="destinations-grid">
            @foreach (var dest in displayedDestinations)
            {
                    <div class="dest-card">
                        <div class="card-img-wrap">
                            <img src="@dest.ImageUrl" alt="@dest.Name"
                                 onerror="this.src='https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600'" />
                            <span class="card-category-badge">@dest.Category</span>
                            <button class="bookmark-btn"
                                    aria-label='@(IsFavorite(dest.Id) ? $"Unsave {dest.Name}" : $"Save {dest.Name}")'
                                    @onclick="() => ToggleFavorite(dest.Id)">
                                <svg width="13" height="13" viewBox="0 0 24 24"
                                     fill='@(IsFavorite(dest.Id) ? "#7B3121" : "none")'
                                     stroke="#7B3121" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round"
                                     aria-hidden="true">
                                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                                </svg>
                            </button>
                        </div>
                        <div class="card-body">
                            <div class="card-top-row">
                                <span class="card-name">@dest.Name</span>
                                <span class="card-rating">
                                    <span class="star" aria-hidden="true">★</span>
                                    <span aria-label="Rating: @dest.Rating.ToString("0.0") out of 5">
                                        @dest.Rating.ToString("0.0")
                                    </span>
                                </span>
                            </div>
                            <div class="card-location">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                                    <circle cx="12" cy="10" r="3"/>
                                </svg>
                                @dest.Province
                            </div>
                            <p class="card-desc">@dest.Description</p>

                            
                            <a href="/destination/@dest.Id" class="btn-explore" aria-label="Explore @dest.Name">
                                Explore →
                            </a>
                        </div>
                    </div>
            }
        </div>

        <p class="results-count" aria-live="polite">
            Showing @displayedDestinations.Count of @allDestinations.Count destinations
        </p>
    }

    <DunesOfArabia.Shared.Footer />
</div>

@code {
    private List<Destination>   allDestinations       = new();
    private HashSet<int>        favoriteIds           = new();
    private List<Destination>   displayedDestinations = new();
    private bool                isLoading             = true;
    private string?             errorMessage;
    private string              searchQuery           = "";
    private string              selectedCategory      = "";
    private string              sortOrder             = "popular";
    private bool                isAuthenticated       = false;

    private record CategoryItem(string Label, string Value);
    private static readonly CategoryItem[] Categories =
    {
        new("All",        ""),
        new("Historical", "Historical"),
        new("Nature",     "Nature"),
        new("Coastal",    "Coastal"),
        new("Desert",     "Desert"),
        new("Mountain",   "Mountain"),
        new("Urban",      "Urban"),
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        try
        {
            allDestinations = await DestinationService.GetAllAsync();

            if (isAuthenticated)
            {
                var userId = authState.User.FindFirst(
                    System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

                if (!string.IsNullOrEmpty(userId))
                {
                    var favorites = await UserFavoriteService.GetFavoritesByUserAsync(userId);
                    favoriteIds = favorites.Select(f => f.DestinationId).ToHashSet();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            errorMessage = "Could not load destinations. Please try again.";
            allDestinations = new List<Destination>();
        }

        RefreshDisplayed();
        isLoading = false;
    }

    private void SetCategory(string cat)
    {
        selectedCategory = cat;
        RefreshDisplayed();
    }

    private void RefreshDisplayed()
    {
        var filtered = allDestinations
            .Where(d =>
                string.IsNullOrEmpty(searchQuery) ||
                d.Name.Contains(searchQuery,        StringComparison.OrdinalIgnoreCase) ||
                d.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                d.Province.Contains(searchQuery,    StringComparison.OrdinalIgnoreCase))
            .Where(d =>
                string.IsNullOrEmpty(selectedCategory) ||
                d.Category.Equals(selectedCategory, StringComparison.OrdinalIgnoreCase));

        displayedDestinations = (sortOrder switch
        {
            "rating_desc" => filtered.OrderByDescending(d => d.Rating),
            "name_asc"    => filtered.OrderBy(d => d.Name),
            "name_desc"   => filtered.OrderByDescending(d => d.Name),
            _             => filtered
        }).ToList();
    }

    private async Task ToggleFavorite(int destinationId)
    {
        if (!isAuthenticated)
        {
            Nav.NavigateTo($"/Account/Login?returnUrl={Uri.EscapeDataString("/destinations")}");
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(userId)) return;

        try
        {
            if (favoriteIds.Contains(destinationId))
            {
                await UserFavoriteService.RemoveFavoriteAsync(userId, destinationId);
                favoriteIds.Remove(destinationId);
            }
            else
            {
                await UserFavoriteService.AddFavoriteAsync(userId, destinationId);
                favoriteIds.Add(destinationId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Favorite toggle error: {ex.Message}");
            errorMessage = "Could not update favorites. Please try again.";
        }
    }

    private bool IsFavorite(int id) => favoriteIds.Contains(id);
}
