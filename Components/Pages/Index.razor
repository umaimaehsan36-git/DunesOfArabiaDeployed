@page "/"
@layout DunesOfArabia.Components.Layout.MainLayout
@rendermode InteractiveServer

@inject IDestinationService          DestinationService
@inject IActivityService             ActivityService
@inject IUserFavoriteService         UserFavoriteService
@inject NavigationManager            Nav
@inject AuthenticationStateProvider  AuthStateProvider
@* IDocumentUploadService removed — booking check moved to Activities page *@

<PageTitle>Home – Dunes of Arabia</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@@0,400;0,600;0,700;1,400&family=Lato:wght@@300;400;600&display=swap');

    /* ── Base ────────────────────────────────────────────── */
    .home-page {
        background-color: #F5EFE8;
        min-height: 100vh;
        font-family: 'Lato', sans-serif;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 2rem;
        overflow-y: auto;
    }

    /* ── Hero ────────────────────────────────────────────── */
    .hero-banner {
        width: 100%;
        min-height: 260px;
        background: linear-gradient(135deg, rgba(15,8,3,0.55) 0%, rgba(90,30,15,0.70) 100%),
                    url('https://images.unsplash.com/photo-1509316785289-025f5b846b35?w=1600') center/cover no-repeat;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 2.5rem 3rem;
        color: white;
        border-radius: 16px;
        gap: 2rem;
    }

    .hero-text h2 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(1.8rem, 3vw, 2.6rem);
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 0.6rem;
    }

    .hero-text p {
        font-size: 0.90rem;
        color: rgba(255,255,255,0.80);
        line-height: 1.65;
        max-width: 420px;
        font-weight: 300;
        margin-bottom: 1.4rem;
    }

    .hero-btns { display: flex; gap: 0.75rem; flex-wrap: wrap; }

    .btn-hero-primary {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 11px 26px; background: #7B3121; color: white;
        border: none; border-radius: 8px; font-size: 0.88rem;
        font-weight: 600; font-family: inherit; text-decoration: none;
        cursor: pointer; transition: background 0.2s, transform 0.15s; white-space: nowrap;
    }
    .btn-hero-primary:hover { background: #5C2218; color: white; transform: translateY(-1px); }

    .btn-hero-outline {
        display: inline-flex; align-items: center; padding: 10px 22px;
        background: transparent; color: white;
        border: 1.5px solid rgba(255,255,255,0.75); border-radius: 8px;
        font-size: 0.88rem; font-weight: 600; text-decoration: none;
        font-family: inherit; transition: background 0.2s; white-space: nowrap;
    }
    .btn-hero-outline:hover { background: rgba(255,255,255,0.12); color: white; }

    /* ── Stats bar ───────────────────────────────────────── */
    .stats-bar { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }

    .stat-card {
        background: white; border-radius: 12px; padding: 1rem 1.25rem;
        display: flex; align-items: center; gap: 0.85rem;
        box-shadow: 0 1px 6px rgba(90,55,35,0.07);
    }

    .stat-icon {
        width: 42px; height: 42px; background: #FAF0E8; border-radius: 10px;
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }

    .stat-text strong { display: block; font-size: 1.3rem; font-weight: 700; color: #1C1008; line-height: 1; }
    .stat-text span   { font-size: 0.76rem; color: #9A8878; font-weight: 400; }

    /* ── Section header ──────────────────────────────────── */
    .section-hd { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 1rem; }

    .section-hd-left h3 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.45rem; color: #1C1008; font-weight: 700; margin-bottom: 0.2rem;
    }
    .section-hd-left p { color: #9A8878; font-size: 0.82rem; font-weight: 300; }

    .btn-see-all {
        display: inline-flex; align-items: center; gap: 5px;
        font-size: 0.84rem; font-weight: 600; color: #7B3121;
        text-decoration: none; font-family: inherit; background: none;
        border: none; cursor: pointer; padding: 0;
        transition: gap 0.2s; white-space: nowrap;
    }
    .btn-see-all:hover { gap: 8px; color: #5C2218; }

    /* ── Destination showcase (3 cards, wider layout) ────── */
    .dest-showcase { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.1rem; }

    .dest-showcase-card {
        position: relative; border-radius: 14px; overflow: hidden;
        height: 240px; cursor: pointer;
        box-shadow: 0 2px 10px rgba(90,55,35,0.10);
        transition: transform 0.22s, box-shadow 0.22s;
        text-decoration: none;
        display: block;
    }
    .dest-showcase-card:hover { transform: translateY(-4px); box-shadow: 0 10px 30px rgba(90,55,35,0.18); }

    .dest-showcase-card img {
        width: 100%; height: 100%; object-fit: cover; display: block;
        transition: transform 0.35s;
    }
    .dest-showcase-card:hover img { transform: scale(1.04); }

    .dest-showcase-overlay {
        position: absolute; inset: 0;
        background: linear-gradient(to top, rgba(10,4,0,0.72) 0%, rgba(10,4,0,0.10) 55%, transparent 100%);
    }

    .dest-showcase-info {
        position: absolute; bottom: 0; left: 0; right: 0;
        padding: 1rem 1.1rem 1.1rem;
        color: white;
        display: flex; align-items: flex-end; justify-content: space-between;
    }

    .dest-showcase-name {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.1rem; font-weight: 700; line-height: 1.2;
        margin-bottom: 3px;
    }

    .dest-showcase-loc {
        font-size: 0.75rem; color: rgba(255,255,255,0.72);
        display: flex; align-items: center; gap: 3px;
    }

    .dest-showcase-rating {
        background: rgba(255,255,255,0.18);
        backdrop-filter: blur(6px);
        border: 1px solid rgba(255,255,255,0.22);
        border-radius: 20px;
        padding: 4px 10px;
        font-size: 0.78rem; font-weight: 700; color: white;
        display: flex; align-items: center; gap: 3px;
        flex-shrink: 0; align-self: flex-end;
    }

    .dest-fav-btn {
        position: absolute; top: 10px; right: 10px;
        width: 32px; height: 32px;
        background: rgba(255,255,255,0.90); border: none; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; font-size: 0.85rem;
        transition: background 0.2s, transform 0.15s;
        box-shadow: 0 1px 5px rgba(0,0,0,0.15);
        z-index: 2;
    }
    .dest-fav-btn:hover { background: white; transform: scale(1.1); }

    /* ── Activity categories strip ───────────────────────── */
    .category-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }

    .cat-card {
        position: relative; border-radius: 14px; overflow: hidden;
        height: 180px; cursor: pointer; text-decoration: none; display: block;
        box-shadow: 0 2px 8px rgba(90,55,35,0.09);
        transition: transform 0.22s, box-shadow 0.22s;
    }
    .cat-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(90,55,35,0.15); }

    .cat-card img {
        width: 100%; height: 100%; object-fit: cover; display: block;
        transition: transform 0.35s;
    }
    .cat-card:hover img { transform: scale(1.06); }

    .cat-overlay {
        position: absolute; inset: 0;
        background: linear-gradient(to top, rgba(10,4,0,0.65) 0%, rgba(10,4,0,0.08) 60%, transparent 100%);
    }

    .cat-info {
        position: absolute; bottom: 0; left: 0; right: 0;
        padding: 0.9rem 1rem;
    }

    .cat-label {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.0rem; font-weight: 700; color: white;
        margin-bottom: 3px;
    }

    /* ── Why Choose Us ───────────────────────────────────── */
    .why-section {
        background: white; border-radius: 14px;
        padding: 1.75rem 2rem;
        box-shadow: 0 1px 8px rgba(90,55,35,0.06);
    }

    .why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 1.25rem; }

    .why-card { display: flex; align-items: flex-start; gap: 0.9rem; }

    .why-icon {
        width: 46px; height: 46px; background: #FAF0E8; border-radius: 10px;
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }

    .why-card h4 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 0.95rem; color: #1C1008; font-weight: 700; margin-bottom: 0.3rem;
    }
    .why-card p { color: #7A6658; font-size: 0.80rem; line-height: 1.6; margin: 0; }

    /* ── CTA ─────────────────────────────────────────────── */
    .cta-banner {
        background: linear-gradient(135deg, #7B3121, #9B4535);
        padding: 2rem 2.5rem; border-radius: 14px;
        display: flex; align-items: center; justify-content: space-between; gap: 2rem;
    }

    .cta-text h3 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.5rem; font-weight: 700; color: white; margin-bottom: 0.35rem;
    }
    .cta-text p { color: rgba(255,255,255,0.75); font-size: 0.86rem; font-weight: 300; margin: 0; }

    .btn-cta {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 12px 28px; background: white;
        color: #7B3121; border: none; border-radius: 8px;
        font-size: 0.88rem; font-weight: 700; text-decoration: none;
        font-family: inherit; cursor: pointer;
        transition: transform 0.15s, box-shadow 0.15s; white-space: nowrap;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        flex-shrink: 0;
    }
    .btn-cta:hover { transform: translateY(-1px); box-shadow: 0 4px 16px rgba(0,0,0,0.2); color: #5C2218; }

    /* ── Skeletons ───────────────────────────────────────── */
    @@keyframes shimmer { 0%{background-position:-400px 0} 100%{background-position:400px 0} }

    .skel-card { background: white; border-radius: 14px; overflow: hidden; box-shadow: 0 1px 6px rgba(90,55,35,0.07); }
    .skel-img { height: 200px; background: linear-gradient(90deg,#ede7df 25%,#f5efe8 50%,#ede7df 75%); background-size:800px 100%; animation: shimmer 1.5s infinite; }
    .skel-img.short { height: 160px; }
    .skel-body { padding: 1rem; }
    .skel-line { height: 12px; background: linear-gradient(90deg,#ede7df 25%,#f5efe8 50%,#ede7df 75%); background-size:800px 100%; animation: shimmer 1.5s infinite; border-radius: 6px; margin-bottom: 8px; }
    .skel-line.short { width: 60%; }
    .skel-line.btn { height: 34px; border-radius: 7px; margin-top: 4px; }
    .skeleton-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.1rem; }
    .skeleton-grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }

    /* ── Error ───────────────────────────────────────────── */
    .error-banner {
        background: #FFE0DC; color: #7A2010; border-radius: 10px;
        padding: 0.85rem 1.25rem; font-size: 0.86rem; font-weight: 600; text-align: center;
    }

    /* ── Responsive ──────────────────────────────────────── */
    @@media (max-width: 900px) {
        .dest-showcase, .skeleton-grid-3 { grid-template-columns: repeat(2, 1fr); }
        .category-strip, .skeleton-grid-4 { grid-template-columns: repeat(2, 1fr); }
    }

    @@media (max-width: 640px) {
        .home-page { padding: 1rem; }
        .hero-banner { padding: 1.5rem; flex-direction: column; align-items: flex-start; }
        .dest-showcase, .skeleton-grid-3 { grid-template-columns: 1fr; }
        .category-strip, .skeleton-grid-4 { grid-template-columns: repeat(2, 1fr); }
        .stats-bar { grid-template-columns: repeat(2, 1fr); }
        .why-grid { grid-template-columns: 1fr; }
        .cta-banner { flex-direction: column; align-items: flex-start; }
    }
</style>

<div class="home-page">

    <!-- ── HERO ──────────────────────────────────────────── -->
    <div class="hero-banner">
        <div class="hero-text">
            <h2>Discover the Magic of<br/>Saudi Arabia</h2>
            <p>Curated travel guides, immersive cultural experiences, and unforgettable adventures across the Kingdom.</p>
            <div class="hero-btns">
                <a href="/destinations" class="btn-hero-primary">
                    Explore Destinations
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
                <a href="/planner" class="btn-hero-outline">Plan a Trip</a>
            </div>
        </div>
    </div>

    <!-- ── STATS BAR ──────────────────────────────────────── -->
    <div class="stats-bar">
        <div class="stat-card">
            <div class="stat-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C8873A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div class="stat-text">
                <strong>@(isLoadingDests ? "…" : destinationCount + "+")</strong>
                <span>Destinations</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C8873A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="stat-text">
                <strong>12K+</strong>
                <span>Happy Travelers</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C8873A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <div class="stat-text">
                <strong>@(isLoadingDests ? "…" : avgRating.ToString("0.0"))</strong>
                <span>Avg. Rating</span>
            </div>
        </div>
    </div>

    <!-- ── FEATURED DESTINATIONS (3-card showcase) ────────── -->
    <div>
        <div class="section-hd">
            <div class="section-hd-left">
                <h3>Featured Destinations</h3>
                <p>A glimpse at what awaits you across the Kingdom</p>
            </div>
            <a href="/destinations" class="btn-see-all">
                View All
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
        </div>

        @if (!string.IsNullOrEmpty(destErrorMessage))
        {
            <div class="error-banner">@destErrorMessage</div>
        }
        else if (isLoadingDests)
        {
            <div class="skeleton-grid-3">
                @for (int i = 0; i < 3; i++) {
                    <div class="skel-card"><div class="skel-img"></div></div>
                }
            </div>
        }
        else
        {
            <div class="dest-showcase">
                @foreach (var dest in featuredDestinations)
                {
                    <a href="/destination/@dest.Id" class="dest-showcase-card">
                        <img src="@dest.ImageUrl" alt="@dest.Name"
                             onerror="this.src='https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600'" />
                        <div class="dest-showcase-overlay"></div>
                        <div class="dest-showcase-info">
                            <div>
                                <div class="dest-showcase-name">@dest.Name</div>
                                <div class="dest-showcase-loc">
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.7)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                    @dest.Province
                                </div>
                            </div>
                            <div class="dest-showcase-rating">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="#D4A017" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                @dest.Rating.ToString("0.0")
                            </div>
                        </div>
                        <button class="dest-fav-btn"
                                @onclick:stopPropagation="true"
                                @onclick="() => ToggleFavorite(dest.Id)"
                                title="@(favIds.Contains(dest.Id) ? "Saved" : "Save")"
                                aria-label="@(favIds.Contains(dest.Id) ? "Remove from favourites" : "Save to favourites")">
                            <svg width="13" height="13" viewBox="0 0 24 24"
                                 fill="@(favIds.Contains(dest.Id) ? "#7B3121" : "none")"
                                 stroke="#7B3121" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                            </svg>
                        </button>
                    </a>
                }
            </div>
        }
    </div>

    <!-- ── EXPLORE BY CATEGORY ────────────────────────────── -->
    <div>
        <div class="section-hd">
            <div class="section-hd-left">
                <h3>Explore by Activity</h3>
                <p>Find experiences that match your travel style</p>
            </div>
            <a href="/activities" class="btn-see-all">
                Browse All
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
        </div>

        @if (isLoadingActivities)
        {
            <div class="skeleton-grid-4">
                @for (int i = 0; i < 4; i++) {
                    <div class="skel-card"><div class="skel-img short"></div></div>
                }
            </div>
        }
        else
        {
            <div class="category-strip">
                @foreach (var cat in activityCategories)
                {
                    <a href="/activities?category=@cat.Slug" class="cat-card">
                        <img src="@cat.Image" alt="@cat.Label"
                             onerror="this.src='https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=500'" />
                        <div class="cat-overlay"></div>
                        <div class="cat-info">
                            <div class="cat-label">@cat.Label</div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>

    <!-- ── WHY CHOOSE US ──────────────────────────────────── -->
    <div class="why-section">
        <div class="section-hd">
            <div class="section-hd-left">
                <h3>Why Choose Us</h3>
                <p>Your journey to discover Saudi Arabia starts here</p>
            </div>
        </div>
        <div class="why-grid">
            <div class="why-card">
                <div class="why-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C8873A" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <div>
                    <h4>Cultural Immersion</h4>
                    <p>Experience authentic Saudi culture, traditions, and hospitality with local guides who know every story.</p>
                </div>
            </div>
            <div class="why-card">
                <div class="why-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C8873A" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <div>
                    <h4>Expert Guides</h4>
                    <p>Journey with knowledgeable local experts who bring history and culture to life at every step.</p>
                </div>
            </div>
            <div class="why-card">
                <div class="why-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C8873A" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
                </div>
                <div>
                    <h4>Curated Experiences</h4>
                    <p>Handpicked destinations and activities designed for travellers seeking genuine, unforgettable moments.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- ── CTA BANNER — guests only ─────────────────────── -->
    @if (currentUserId is null)
    {
    <div class="cta-banner">
        <div class="cta-text">
            <h3>Ready to Start Your Adventure?</h3>
            <p>Join thousands of travelers discovering the beauty of Saudi Arabia</p>
        </div>
        <a href="/Account/Register" class="btn-cta">
            Get Started Today
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
    </div>
    }

    <DunesOfArabia.Shared.Footer />
</div>

@code {
    // ── State ──────────────────────────────────────────────
    private List<Destination> featuredDestinations = new();
    private HashSet<int>      favIds               = new();

    private bool    isLoadingDests      = true;
    private bool    isLoadingActivities = true;
    private string? destErrorMessage;

    // Stats
    private int    destinationCount;
    private int    activityCount;
    private double avgRating;

    private string? currentUserId;

    // ── Category strip data ────────────────────────────────
    private List<CategoryInfo> activityCategories = new();

    private record CategoryInfo(string Label, string Slug, string Image, int Count);

    private static readonly Dictionary<string, string> CategoryImages = new(StringComparer.OrdinalIgnoreCase)
    {
        ["adventure"] = "https://images.unsplash.com/photo-1509316785289-025f5b846b35?w=600",
        ["cultural"]  = "https://images.unsplash.com/photo-1539667284076-a4d98d9ac42b?w=600",
        ["water"]     = "https://images.unsplash.com/photo-1564769611905-cd27ee64e59b?w=600",
        ["desert"]    = "https://images.unsplash.com/photo-1549880338-65ddcdfd017b?w=600",
    };

    private static readonly Dictionary<string, string> CategoryLabels = new(StringComparer.OrdinalIgnoreCase)
    {
        ["adventure"] = "Adventure",
        ["cultural"]  = "Cultural",
        ["water"]     = "Water Sports",
        ["desert"]    = "Desert",
    };

    private static readonly string[] CategoryOrder = { "Adventure", "Cultural", "Water", "Desert" };

    // ── Lifecycle ──────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
            currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        await Task.WhenAll(LoadDestinationsAsync(), LoadActivitiesAsync());

        if (currentUserId is not null)
        {
            try
            {
                var saved = await UserFavoriteService.GetUserFavoritesAsync(currentUserId);
                favIds = saved.Select(f => f.DestinationId).ToHashSet();
            }
            catch { /* non-critical */ }
        }
    }

    // ── Data loaders ───────────────────────────────────────
    private async Task LoadDestinationsAsync()
    {
        try
        {
            var all = await DestinationService.GetAllAsync();
            featuredDestinations = all.Take(3).ToList();
            destinationCount     = all.Count;
            avgRating            = all.Count > 0 ? Math.Round(all.Average(d => d.Rating), 1) : 0.0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Index] Destinations error: {ex.Message}");
            destErrorMessage = "Unable to load destinations. Please refresh the page.";
        }
        finally { isLoadingDests = false; }
    }

    private async Task LoadActivitiesAsync()
    {
        try
        {
            var all = await ActivityService.GetAllAsync();
            activityCount = all.Count;

            var grouped = all
                .GroupBy(a => (a.Category ?? "Other").Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.Count(), StringComparer.OrdinalIgnoreCase);

            activityCategories = CategoryOrder.Select(c => new CategoryInfo(
                Label: CategoryLabels.GetValueOrDefault(c, c),
                Slug:  c.ToLower(),
                Image: CategoryImages.GetValueOrDefault(c.ToLower(),
                       "https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600"),
                Count: grouped.GetValueOrDefault(c, 0)
            )).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Index] Activities error: {ex.Message}");
            activityCategories = CategoryOrder.Select(c => new CategoryInfo(
                Label: CategoryLabels.GetValueOrDefault(c, c),
                Slug:  c.ToLower(),
                Image: CategoryImages.GetValueOrDefault(c.ToLower(),
                       "https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600"),
                Count: 0
            )).ToList();
        }
        finally { isLoadingActivities = false; }
    }

    // ── Favourite toggle ────────────────────────────────────
    private async Task ToggleFavorite(int destinationId)
    {
        if (currentUserId is null)
        {
            Nav.NavigateTo("/Account/Login?returnUrl=/", forceLoad: false);
            return;
        }

        if (favIds.Contains(destinationId))
        {
            await UserFavoriteService.RemoveFavoriteAsync(currentUserId, destinationId);
            favIds.Remove(destinationId);
        }
        else
        {
            await UserFavoriteService.AddFavoriteAsync(currentUserId, destinationId);
            favIds.Add(destinationId);
        }
    }
}
