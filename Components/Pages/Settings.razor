    // ── Delete account ────────────────────────────────────────────────────
    private async Task DeleteAccountAsync()
    {
        if (appUser is null) return;
        isDeletingAccount = true;
        deleteErrorMsg = null;
        StateHasChanged();

        try
        {
            var passwordOk = await UserManager.CheckPasswordAsync(appUser, deleteConfirmPassword);
            if (!passwordOk)
            {
                deleteErrorMsg    = "Incorrect password. Please try again.";
                isDeletingAccount = false;
                return;
            }

            var result = await UserManager.DeleteAsync(appUser);
            if (result.Succeeded)
            {
                await SignInManager.SignOutAsync();
                Nav.NavigateTo("/", forceLoad: true);
            }
            else
            {
                deleteErrorMsg    = string.Join("; ", result.Errors.Select(e => e.Description));
                isDeletingAccount = false;
            }
        }
        catch (Exception ex)
        {
            deleteErrorMsg    = $"An error occurred: {ex.Message}";
            isDeletingAccount = false;
        }
    }

    // ── Claim helpers ─────────────────────────────────────────────────────
    private async Task SetClaimAsync(string type, string value)
    {
        if (appUser is null) return;
        var existing = await UserManager.GetClaimsAsync(appUser);
        var old      = existing.FirstOrDefault(c => c.Type == type);
        var newClaim = new System.Security.Claims.Claim(type, value);

        if (old != null)
            await UserManager.ReplaceClaimAsync(appUser, old, newClaim);
        else
            await UserManager.AddClaimAsync(appUser, newClaim);

        // Keep local cache in sync
        _claims[type] = value;
    }

    private bool GetBoolClaim(string type, bool defaultValue)
    {
        if (_claims.TryGetValue(type, out var val))
            return val.Equals("True", StringComparison.OrdinalIgnoreCase);
        return defaultValue;
    }

    private string GetStringClaim(string type, string defaultValue)
        => _claims.TryGetValue(type, out var val) ? val : defaultValue;

    // ── Complaint / Help & Feedback (sir's requirement) ─────────────────
    private string  complaintType        = "";
    private string  complaintSubject     = "";
    private string  complaintDescription = "";
    private bool    isSavingComplaint    = false;
    private string? complaintMsg;
    private bool    complaintSuccess;

    private async Task SubmitComplaintAsync()
    {
        complaintMsg = null;

        if (string.IsNullOrWhiteSpace(complaintType))
        { complaintMsg = "Please select an issue type."; complaintSuccess = false; return; }

        if (string.IsNullOrWhiteSpace(complaintSubject))
        { complaintMsg = "Please enter a subject."; complaintSuccess = false; return; }

        if (string.IsNullOrWhiteSpace(complaintDescription))
        { complaintMsg = "Please describe your issue."; complaintSuccess = false; return; }

        isSavingComplaint = true;
        StateHasChanged();

        try
        {
            await ComplaintService.SubmitComplaintAsync(new Complaint
            {
                UserId      = userId,
                Category    = complaintType,
                Subject     = complaintSubject,
                Description = complaintDescription,
                Message     = complaintDescription,   // kept for backwards compatibility
            });
            complaintMsg        = "✅ Your feedback has been submitted. We respond within 24 hours.";
            complaintSuccess    = true;
            complaintType       = "";
            complaintSubject    = "";
            complaintDescription = "";
        }
        catch (Exception ex)
        {
            complaintMsg    = $"Failed to submit: {ex.Message}";
            complaintSuccess = false;
        }
        finally { isSavingComplaint = false; }
    }


