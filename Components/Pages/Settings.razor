    // ─────────────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";

        appUser = await UserManager.FindByIdAsync(userId);
        if (appUser is null) { Nav.NavigateTo("/Account/Login"); return; }

        var rawClaims = await UserManager.GetClaimsAsync(appUser);
        _claims = rawClaims
            .GroupBy(c => c.Type)
            .ToDictionary(g => g.Key, g => g.Last().Value);

        // ── FIX 1: Load first/last name — FullName column is the source of truth ──
        // On first login, claims may not exist yet. Split FullName first; fall back
        // to splitting UserName (the email prefix) only as a last resort.
        firstName = GetStringClaim("first_name", "");
        lastName  = GetStringClaim("last_name",  "");

        if (string.IsNullOrWhiteSpace(firstName) && !string.IsNullOrWhiteSpace(appUser.FullName))
        {
            var parts = appUser.FullName.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
            firstName = parts.Length > 0 ? parts[0] : appUser.FullName;
            lastName  = parts.Length > 1 ? parts[1] : "";
        }

        if (string.IsNullOrWhiteSpace(firstName))
        {
            var displayName = appUser.UserName ?? "";
            var parts = displayName.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
            firstName = parts.Length > 0 ? parts[0] : displayName;
            lastName  = parts.Length > 1 ? parts[1] : "";
        }

        // ── FIX 2: Phone — guard against null explicitly ──────────────────
        userEmail   = appUser.Email ?? "";
        phoneNumber = appUser.PhoneNumber ?? "";   // guaranteed string, never null

        // ── Nationality & date of birth (required for booking gate) ───────
        nationality = GetStringClaim("nationality", "");
        var dobStr  = GetStringClaim("date_of_birth", "");
        if (!string.IsNullOrEmpty(dobStr) && DateTime.TryParse(dobStr, out var dob)) dateOfBirth = dob;

        // ── Notifications ─────────────────────────────────────────────────
        notifEmail      = GetBoolClaim("notif_email",      true);
        notifBooking    = GetBoolClaim("notif_booking",    true);
        notifReminders  = GetBoolClaim("notif_reminders",  true);
        notifPromo      = GetBoolClaim("notif_promo",      false);
        notifNewsletter = GetBoolClaim("notif_newsletter", false);

        // ── Preferences ───────────────────────────────────────────────────
        prefLanguage     = GetStringClaim("pref_language", "en");
        prefCurrency     = GetStringClaim("pref_currency", "SAR");
        prefTimezone     = GetStringClaim("pref_timezone", "AST");
        prefDistanceUnit = GetStringClaim("pref_distance", "km");

        // ── Privacy ───────────────────────────────────────────────────────
        privacyProfileVisible = GetBoolClaim("priv_visible", true);
        privacyShowHistory    = GetBoolClaim("priv_history",  true);
        twoFactorEnabled      = appUser.TwoFactorEnabled;

        isLoading = false;
    }

    // ── Save account info + optional password change ──────────────────────
    private async Task SaveAccountAsync()
    {
        isSavingProfile = true;
        profileMsg  = null;
        passwordMsg = null;
        StateHasChanged();

        try
        {
            // ── FIX 1: Store first & last name as claims AND sync FullName ──
            // UserName must be unique and is set to email — never overwrite it.
            // Claims hold the display name; FullName on ApplicationUser is the
            // authoritative column read by Profile.razor via UserManager.
            await SetClaimAsync("first_name", firstName.Trim());
            await SetClaimAsync("last_name",  lastName.Trim());

            var fullName = (firstName.Trim() + " " + lastName.Trim()).Trim();
            if (appUser!.FullName != fullName)
            {
                appUser.FullName = fullName;
                await UserManager.UpdateAsync(appUser);
            }

            // ── Nationality & date of birth (booking gate requirements) ───
            if (!string.IsNullOrWhiteSpace(nationality))
                await SetClaimAsync("nationality", nationality.Trim());
            if (dateOfBirth.HasValue)
                await SetClaimAsync("date_of_birth", dateOfBirth.Value.ToString("yyyy-MM-dd"));

            // ── FIX 2+3: Save phone number via the proper Identity API ──────
            // Direct appUser.PhoneNumber = value works but doesn't update the
            // security stamp. SetPhoneNumberAsync is the correct method, and
            // it calls UpdateAsync internally, so we only need UpdateAsync as
            // a fallback for non-phone fields.
            var trimmedPhone = phoneNumber.Trim();
            if (appUser!.PhoneNumber != trimmedPhone)
            {
                var phoneResult = await UserManager.SetPhoneNumberAsync(appUser, trimmedPhone);
                if (!phoneResult.Succeeded)
                {
                    profileMsg    = string.Join("; ", phoneResult.Errors.Select(e => e.Description));
                    profileSuccess = false;
                    isSavingProfile = false;
                    return;
                }
            }

            profileMsg    = "Profile updated successfully.";
            profileSuccess = true;

            // FIX 3: Reissue the auth cookie so the new phone_number / nationality
            // claims are visible immediately — without this the profile gate on
            // Profile.razor still shows them as incomplete until the user logs out.
            await SignInManager.RefreshSignInAsync(appUser);

            // ── FIX 3: Only attempt password change when ALL three fields
            //           are non-empty — avoids spurious "enter password" error
            //           when user is only updating name/phone. ─────────────
            bool hasCurrentPw = !string.IsNullOrWhiteSpace(currentPassword);
            bool hasNewPw     = !string.IsNullOrWhiteSpace(newPassword);
            bool hasConfirmPw = !string.IsNullOrWhiteSpace(confirmPassword);

            if (hasCurrentPw || hasNewPw || hasConfirmPw)
            {
                // At least one field touched → validate all three
                if (!hasCurrentPw)
                {
                    passwordMsg    = "Please enter your current password.";
                    passwordSuccess = false;
                }
                else if (!hasNewPw)
                {
                    passwordMsg    = "Please enter a new password.";
                    passwordSuccess = false;
                }
                else if (!hasConfirmPw || newPassword != confirmPassword)
                {
                    passwordMsg    = "New passwords do not match.";
                    passwordSuccess = false;
                }
                else
                {
                    var pwResult = await UserManager.ChangePasswordAsync(appUser, currentPassword, newPassword);
                    if (pwResult.Succeeded)
                    {
                        passwordMsg    = "Password changed successfully.";
                        passwordSuccess = true;
                        currentPassword = "";
                        newPassword     = "";
                        confirmPassword = "";
                        await SignInManager.RefreshSignInAsync(appUser);
                    }
                    else
                    {
                        passwordMsg    = string.Join("; ", pwResult.Errors.Select(e => e.Description));
                        passwordSuccess = false;
                    }
                }
            }
            // If all three password fields are empty → skip silently (user just updated name/phone)
        }
        catch (Exception ex)
        {
            profileMsg    = $"An error occurred: {ex.Message}";
            profileSuccess = false;
        }
        finally
        {
            isSavingProfile = false;
        }
    }

