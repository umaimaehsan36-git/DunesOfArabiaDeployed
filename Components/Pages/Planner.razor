    // ── Computed ──────────────────────────────────────────────────────────────
    private int TripDays => (startDate.HasValue && endDate.HasValue && endDate > startDate) ? (int)(endDate.Value - startDate.Value).TotalDays : 0;
    private string TransportLabel => selectedTransport switch { "saptco" => "SAPTCO Bus", "careem" => "Careem / Private Car", "flight" => "Domestic Flight", "train" => "SAR Train (Haramain)", "none" => "Own arrangement", _ => "Not selected" };
    private int TransportCost => selectedTransport switch { "saptco" => 120 * numTravelers, "careem" => 300 * numTravelers, "flight" => 500 * numTravelers, "train" => 90 * numTravelers, _ => 0 };
    private string TotalCostDisplay
    {
        get
        {
            var planBase      = (selectedPlan?.BasePrice ?? budgetPerPerson) * numTravelers;
            var activitiesCost = step2SelectedActivities.Any()
                ? step2SelectedActivities.Sum(a => a.Price) * numTravelers
                : incomingActivityTotal > 0
                    ? incomingActivityTotal * numTravelers
                    : incomingActivityIds.Count * 150m * numTravelers;
            var subtotal = planBase + activitiesCost + TransportCost;
            return (subtotal * 1.15m).ToString("N0");
        }
    }

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        var uri   = new Uri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("destinationId", out var dIdVal) && int.TryParse(dIdVal, out var dId))
        {
            incomingDestinationId = dId;
            selectedDestinationId = dId;
        }

        if (query.TryGetValue("activities", out var actVal) && !string.IsNullOrEmpty(actVal))
        {
            incomingActivityIds = actVal.ToString()
                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(s => int.TryParse(s, out var n) ? n : 0)
                .Where(n => n > 0).ToList();
        }

        if (query.TryGetValue("activityTotal", out var actTotalVal))
            decimal.TryParse(actTotalVal, out incomingActivityTotal);

        try { allDestinations = await DestinationService.GetAllAsync(); }
        catch (Exception ex) { Console.WriteLine("[Planner] Destinations: " + ex.Message); }

        if (incomingDestinationId > 0)
            incomingDestinationName = allDestinations.FirstOrDefault(d => d.Id == incomingDestinationId)?.Name ?? $"Destination #{incomingDestinationId}";

        // Read dates from query string (set when coming from MyItineraries "Edit in Planner")
        if (query.TryGetValue("startDate", out var sdVal) && DateTime.TryParse(sdVal, out var sdParsed))
            startDate = sdParsed;
        else
            startDate = DateTime.Today.AddDays(14);

        if (query.TryGetValue("endDate", out var edVal) && DateTime.TryParse(edVal, out var edParsed))
            endDate = edParsed;
        else
            endDate = DateTime.Today.AddDays(21);

        if (selectedDestinationId > 0)
            await LoadDestinationActivitiesAsync();

        // Destination is pre-selected from DestinationDetails, but user still
        // starts at Step 1 (Choose Plan) — that is always the first decision.
        // We do NOT auto-advance; we only pre-select the destination dropdown.
        if (incomingDestinationId > 0 && selectedPlanId == 0)
            SelectPlan(prebuiltPlans[1]); // Heritage Discovery as a helpful default
    }

    private async Task LoadDestinationActivitiesAsync()
    {
        if (selectedDestinationId <= 0) return;
        activitiesLoading = true;
        StateHasChanged();
        try
        {
            // Fetches ONLY activities for this destination from DB — not all activities
            var result = await ActivityService.GetByDestinationIdAsync(selectedDestinationId);
            destinationActivities = result?.ToList() ?? new();
            // Pre-select any activities passed in from DestinationDetails
            step2SelectedActivityIds = incomingActivityIds.ToHashSet();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Planner] Activities for dest {selectedDestinationId}: {ex.Message}");
            destinationActivities = new();
        }
        activitiesLoading = false;
    }

    private void ToggleStep2Activity(Activity act)
    {
        if (step2SelectedActivityIds.Contains(act.Id)) step2SelectedActivityIds.Remove(act.Id);
        else step2SelectedActivityIds.Add(act.Id);
        StateHasChanged();
    }

    // ── AI Suggestion (FIXED — calls Claude API properly) ─────────────────────
    private async Task RunAiSuggestion()
    {
        if (string.IsNullOrWhiteSpace(aiPromptText)) return;
        aiLoading = true;
        aiResult  = "";
        aiIsError = false;
        StateHasChanged();

        try
        {
            var planList = string.Join("; ", prebuiltPlans.Select(p =>
                $"{p.Name} ({p.Category}, {p.Days} days, SR {p.BasePrice}/person, {p.ActivitiesIncluded} activities, {p.HotelTier}, includes meals: {p.MealsIncluded}, transport: {p.TransportIncluded})"));

            var systemPrompt = $"You are a Saudi Arabia travel expert for Dunes of Arabia. The user will describe their ideal trip. Recommend the single best plan from this list: {planList}. Respond ONLY with valid JSON (no markdown, no backticks): {{\"recommendedPlan\": \"<exact plan name from the list>\", \"reason\": \"<2-3 sentences explaining why this plan fits their needs>\"}}";

            var requestBody = new
            {
                model      = "llama-3.3-70b-versatile",
                max_tokens = 400,
                messages   = new[]
                {
                    new { role = "system", content = systemPrompt },
                    new { role = "user",   content = aiPromptText }
                }
            };

            var json    = System.Text.Json.JsonSerializer.Serialize(requestBody);
            var content = new System.Net.Http.StringContent(json, System.Text.Encoding.UTF8, "application/json");

            using var http = HttpClientFactory.CreateClient();
            http.DefaultRequestHeaders.Add("Authorization", $"Bearer {Configuration["Groq:ApiKey"]}");

            var response = await http.PostAsync("https://api.groq.com/openai/v1/chat/completions", content);
            if (!response.IsSuccessStatusCode)
            {
                aiResult  = $"⚠️ AI service returned {(int)response.StatusCode}. Please try the Smart Match sliders below instead.";
                aiIsError = true;
            }
            else
            {
                var raw = await response.Content.ReadAsStringAsync();
                using var doc  = System.Text.Json.JsonDocument.Parse(raw);
                var textBlock  = doc.RootElement
                                    .GetProperty("choices")[0]
                                    .GetProperty("message")
                                    .GetProperty("content")
                                    .GetString() ?? "";

                // Strip any accidental markdown fences
                textBlock = textBlock.Trim();
                if (textBlock.StartsWith("```")) { textBlock = textBlock.Split('\n', 2).Last(); }
                if (textBlock.EndsWith("```"))   { textBlock = textBlock[..textBlock.LastIndexOf("```")]; }
                textBlock = textBlock.Trim();

                using var resultDoc = System.Text.Json.JsonDocument.Parse(textBlock);
                var planName        = resultDoc.RootElement.GetProperty("recommendedPlan").GetString() ?? "";
                var reason          = resultDoc.RootElement.GetProperty("reason").GetString() ?? "";

                var match = prebuiltPlans.FirstOrDefault(p => p.Name.Equals(planName, StringComparison.OrdinalIgnoreCase));
                if (match != null) SelectPlan(match);

                aiResult = $"✨ {reason}";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Planner] AI suggestion error: {ex.Message}");
            aiResult  = "⚠️ Could not get AI recommendation right now. Please try the Smart Match sliders below instead.";
            aiIsError = true;
        }

        aiLoading = false;
        StateHasChanged();
    }

    // ── Plan selection ────────────────────────────────────────────────────────
    private void SelectPlan(PlanTemplate plan)
    {
        selectedPlanId  = plan.Id;
        selectedPlan    = plan;
        budgetPerPerson = (int)plan.BasePrice;
    }

    // ── MCDM Matching ─────────────────────────────────────────────────────────
    private void RunMcdmMatch()
    {
        var userVec = new[] { mcdmBudget, mcdmAdventure, mcdmCulture, mcdmFamily, mcdmLuxury };
        PlanTemplate? best = null;
        double bestScore = double.MaxValue;
        foreach (var plan in prebuiltPlans)
        {
            var pVec = new[] { plan.WBudget, plan.WAdventure, plan.WCulture, plan.WFamily, plan.WLuxury };
            double dist = 0;
            for (int i = 0; i < userVec.Length; i++) dist += Math.Pow(userVec[i] - pVec[i], 2);
            dist = Math.Sqrt(dist);
            if (dist < bestScore) { bestScore = dist; best = plan; }
        }
        if (best != null) { mcdmResult = $"Best match: \"{best.Name}\" — {best.Description}"; SelectPlan(best); }

        mcdmRanking = prebuiltPlans
            .Select(plan => {
                var pVec = new[] { plan.WBudget, plan.WAdventure, plan.WCulture, plan.WFamily, plan.WLuxury };
                var userVec2 = new[] { mcdmBudget, mcdmAdventure, mcdmCulture, mcdmFamily, mcdmLuxury };
                double dist = 0;
                for (int i = 0; i < pVec.Length; i++) dist += Math.Pow(userVec2[i] - pVec[i], 2);
                return (plan.Name, Math.Sqrt(dist), plan.BadgeClass);
            })
            .OrderBy(x => x.Item2)
            .ToList();
    }

    private string McdmLabel(int val) => val switch { 1 => "Not important", 2 => "Slightly", 3 => "Moderate", 4 => "Important", 5 => "Very important", _ => "—" };

    // ── Navigation ────────────────────────────────────────────────────────────
    private async Task GoNext()
    {
        if (currentStep == 1 && selectedDestinationId > 0 && !destinationActivities.Any())
            await LoadDestinationActivitiesAsync();
        if (currentStep < 4) currentStep++;
    }
    private void GoBack() { if (currentStep > 1) currentStep--; }
    private void SetTripType(string type) { tripType = type; if (type == "Solo") numTravelers = 1; if (type == "Couple") numTravelers = 2; }
    private void IncrementTravelers() { if (tripType == "Solo") return; if (tripType == "Couple" && numTravelers >= 2) return; if (numTravelers < 20) numTravelers++; }
    private void DecrementTravelers() { if (tripType == "Solo") return; if (tripType == "Couple") { if (numTravelers > 2) numTravelers--; return; } if (numTravelers > 1) numTravelers--; }
    private string? GetDestinationName() => allDestinations.FirstOrDefault(d => d.Id == selectedDestinationId)?.Name;

    // ── Save Itinerary ────────────────────────────────────────────────────────
    private string? currentUserId;
    private bool    isSaving     = false;
    private string? saveMessage;

    private async Task SaveItinerary()
    {
        isSaving    = true;
        saveMessage = null;
        StateHasChanged();

        // Auth check
        if (currentUserId is null)
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            currentUserId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        }
        if (currentUserId is null)
        {
            Nav.NavigateTo("/Account/Login?returnUrl=/planner", forceLoad: false);
            return;
        }

        // Validation
        if (selectedDestinationId <= 0)
        {
            saveMessage = "❌ Please select a destination before saving.";
            isSaving = false;
            StateHasChanged();
            return;
        }
        if (!startDate.HasValue || !endDate.HasValue || endDate <= startDate)
        {
            saveMessage = "❌ Please set valid travel dates before saving.";
            isSaving = false;
            StateHasChanged();
            return;
        }

        try
        {
            var itinerary = new Itinerary
            {
                UserId        = currentUserId,
                Title         = (selectedPlan?.Name ?? "Custom Plan") + " – " + (GetDestinationName() ?? "Saudi Arabia"),
                DestinationId = selectedDestinationId,
                StartDate     = startDate.Value,
                EndDate       = endDate.Value,
                Travelers     = numTravelers,
                TripType      = tripType,
                Interests     = new List<string> { selectedPlan?.Category ?? "Custom" }
            };
            await ItineraryService.SaveAsync(itinerary);
            saveMessage = "✅ Itinerary saved! Redirecting…";
            StateHasChanged();
            await Task.Delay(800);
            Nav.NavigateTo("/itinerary");
        }
        catch (Exception ex)
        {
            var inner = ex.InnerException?.Message ?? ex.Message;
            Console.WriteLine($"[Planner] SaveItinerary error: {ex}");
            saveMessage = $"❌ Could not save itinerary: {inner}";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    // ── Proceed to Checkout ───────────────────────────────────────────────────
    private void ProceedToCheckout()
    {
        var actIds     = string.Join(",", step2SelectedActivityIds);
        // Use real prices from step-2 selection; fall back to incoming total from DestinationDetails
        var actTotal   = step2SelectedActivities.Any()
                            ? step2SelectedActivities.Sum(a => a.Price)
                            : incomingActivityTotal;
        var url = $"/checkout" +
                  $"?destinationId={selectedDestinationId}" +
                  $"&destinationName={Uri.EscapeDataString(GetDestinationName() ?? "")}" +
                  $"&planName={Uri.EscapeDataString(selectedPlan?.Name ?? "Custom Plan")}" +
                  $"&planPrice={selectedPlan?.BasePrice ?? budgetPerPerson}" +
                  $"&travelers={numTravelers}" +
                  $"&transport={selectedTransport}" +
                  $"&transportCost={TransportCost}" +
                  $"&startDate={startDate?.ToString("yyyy-MM-dd") ?? ""}" +
                  $"&endDate={endDate?.ToString("yyyy-MM-dd") ?? ""}" +
                  (!string.IsNullOrEmpty(actIds) ? $"&activities={Uri.EscapeDataString(actIds)}&activityTotal={actTotal}" : "");
        Nav.NavigateTo(url);
    }
