    // ── Planner state ─────────────────────────────────────────────────────────
    private int               currentStep           = 1;
    private List<Destination> allDestinations       = new();
    private int               selectedDestinationId = 0;
    private DateTime?         startDate;
    private DateTime?         endDate;
    private int               numTravelers          = 2;
    private string            tripType              = "Couple";
    private int               budgetPerPerson       = 2000;
    private string            selectedTransport     = "";

    // ── Step-2 activities (loaded from DB per destination) ────────────────────
    private List<Activity> destinationActivities    = new();
    private HashSet<int>   step2SelectedActivityIds = new();
    private List<Activity> step2SelectedActivities  => destinationActivities.Where(a => step2SelectedActivityIds.Contains(a.Id)).ToList();
    private bool           activitiesLoading        = false;

    // ── AI suggestion ─────────────────────────────────────────────────────────
    private string aiPromptText = "";
    private string aiResult     = "";
    private bool   aiLoading    = false;
    private bool   aiIsError    = false;

    // ── Plans ─────────────────────────────────────────────────────────────────
    private int          selectedPlanId = 0;
    private PlanTemplate? selectedPlan;
    private HashSet<int> expandedPlanIds = new();

    // ── MCDM ─────────────────────────────────────────────────────────────────
    private int    mcdmBudget    = 3;
    private int    mcdmAdventure = 3;
    private int    mcdmCulture   = 3;
    private int    mcdmFamily    = 2;
    private int    mcdmLuxury    = 2;
    private string mcdmResult    = "";
    private List<(string Name, double Score, string Badge)> mcdmRanking = new();

    private class PlanTemplate
    {
        public int    Id                 { get; init; }
        public string Name               { get; init; } = "";
        public string Category           { get; init; } = "";
        public string BadgeClass         { get; init; } = "";
        public string Description        { get; init; } = "";
        public string ImageUrl           { get; init; } = "";
        public int    Days               { get; init; }
        public string Travelers          { get; init; } = "";
        public decimal BasePrice         { get; init; }
        public string HotelTier          { get; init; } = "";
        public int    ActivitiesIncluded { get; init; }
        public bool   MealsIncluded      { get; init; }
        public bool   TransportIncluded  { get; init; }
        public List<string> DayByDay     { get; init; } = new();
        public int WBudget    { get; init; }
        public int WAdventure { get; init; }
        public int WCulture   { get; init; }
        public int WFamily    { get; init; }
        public int WLuxury    { get; init; }
    }

    private readonly List<PlanTemplate> prebuiltPlans = new()
    {
        new PlanTemplate { Id=1, Name="Budget Explorer", Category="Budget", BadgeClass="badge-budget", Description="4-day Riyadh highlights on a shoestring — cultural tours, heritage walks, and famous landmarks.", ImageUrl="https://images.unsplash.com/photo-1586724237569-f3d0c1dee8c6?w=600", Days=4, Travelers="1–4 people", BasePrice=600, HotelTier="3-star", ActivitiesIncluded=3, MealsIncluded=false, TransportIncluded=false, DayByDay=new(){"Day 1: Arrive Riyadh · Heritage Walking Tour","Day 2: Diriyah UNESCO Site · Traditional Souq","Day 3: Kingdom Centre Tower · Al-Masmak Fortress","Day 4: National Museum · Departure"}, WBudget=5, WAdventure=2, WCulture=3, WFamily=2, WLuxury=1 },
        new PlanTemplate { Id=2, Name="Heritage Discovery", Category="Cultural", BadgeClass="badge-cultural", Description="6-day deep dive into ancient Saudi history: Diriyah, AlUla, and Madain Saleh UNESCO sites.", ImageUrl="https://images.unsplash.com/photo-1591604466107-ec97de577aff?w=600", Days=6, Travelers="1–8 people", BasePrice=1800, HotelTier="4-star", ActivitiesIncluded=5, MealsIncluded=true, TransportIncluded=false, DayByDay=new(){"Day 1: Arrive Riyadh · Diriyah at-Turaif","Day 2: Fly to AlUla · Hegra Archaeological Site","Day 3: Dadan & Jabal Ikmah inscriptions","Day 4: Madain Saleh (Hegra UNESCO) full day","Day 5: AlUla Old Town & Souq","Day 6: Return flight"}, WBudget=3, WAdventure=2, WCulture=5, WFamily=3, WLuxury=2 },
        new PlanTemplate { Id=3, Name="Desert Adventure", Category="Adventure", BadgeClass="badge-adventure", Description="5 days of dune bashing, camel trekking, stargazing, and Bedouin camp experiences.", ImageUrl="https://images.unsplash.com/photo-1509316785289-025f5b846b35?w=600", Days=5, Travelers="2–10 people", BasePrice=1400, HotelTier="Desert eco-lodge", ActivitiesIncluded=4, MealsIncluded=true, TransportIncluded=true, DayByDay=new(){"Day 1: Arrive Riyadh · Drive to Empty Quarter","Day 2: Dune Bashing & Desert Safari","Day 3: Camel Trekking · Sunset dunes","Day 4: Bedouin Camp · Stargazing","Day 5: Return to Riyadh"}, WBudget=2, WAdventure=5, WCulture=2, WFamily=3, WLuxury=2 },
