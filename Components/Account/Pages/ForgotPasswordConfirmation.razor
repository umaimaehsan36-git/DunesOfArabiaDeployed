@page "/Account/ForgotPasswordConfirmation"
@layout DunesOfArabia.Components.Layout.EmptyLayout

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using DunesOfArabia.Data

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager NavigationManager

<PageTitle>Check Your Email – Dunes Of Arabia</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap');

    *, *::before, *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .auth-page {
        min-height: 100vh;
        background: radial-gradient(ellipse at 60% 40%,#E8D9C5 0%,#DFD0B8 50%,#D4C4A8 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        font-family: 'Inter','Segoe UI',sans-serif;
    }

    .auth-brand {
        text-align: center;
        margin-bottom: 2rem;
    }

        .auth-brand h1 {
            font-family: 'Playfair Display',Georgia,serif;
            font-size: 2.6rem;
            font-weight: 700;
            color: #7B2D10;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: .4rem;
        }

        .auth-brand p {
            font-size: 1rem;
            color: #8B6650;
        }

    .auth-card {
        background: #FFF;
        border-radius: 16px;
        padding: 3rem;
        width: 100%;
        max-width: 520px;
        box-shadow: 0 4px 40px rgba(100,50,20,.10);
        text-align: center;
    }

    .success-icon {
        font-size: 4rem;
        margin-bottom: 1.25rem;
    }

    .card-title {
        font-family: 'Playfair Display',Georgia,serif;
        font-size: 1.85rem;
        font-weight: 600;
        color: #1C0F07;
        margin-bottom: 1rem;
    }

    .card-body {
        font-size: .95rem;
        color: #5A3E30;
        line-height: 1.7;
        margin-bottom: 2rem;
    }

    .info-box {
        background: #FBF7F2;
        border: 1px solid #E5D8C8;
        border-radius: 10px;
        padding: 1rem 1.25rem;
        font-size: .85rem;
        color: #7A6050;
        line-height: 1.6;
        margin-bottom: 2rem;
        text-align: left;
    }

        .info-box strong {
            color: #1C0F07;
        }
    /* Dev box */
    .dev-box {
        background: #EFF6FF;
        border: 1px solid #BFDBFE;
        border-radius: 10px;
        padding: 1rem 1.25rem;
        font-size: .85rem;
        color: #1E40AF;
        line-height: 1.6;
        margin-bottom: 2rem;
        text-align: left;
    }

        .dev-box strong {
            color: #1D4ED8;
            display: block;
            margin-bottom: 6px;
        }

        .dev-box a {
            color: #1D4ED8;
            font-weight: 600;
            word-break: break-all;
        }

    .btn-primary {
        display: inline-block;
        padding: 13px 32px;
        background-color: #7B2D10;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: .95rem;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        text-decoration: none;
        transition: background-color .25s,transform .2s;
    }

        .btn-primary:hover {
            background-color: #5C2009;
            transform: translateY(-1px);
        }

    .resend-link {
        margin-top: 1.25rem;
        font-size: .875rem;
        color: #8B6650;
    }

        .resend-link a {
            color: #7B2D10;
            font-weight: 600;
            text-decoration: none;
        }

            .resend-link a:hover {
                text-decoration: underline;
            }

    @@media (max-width:600px) {
        .auth-card {
            padding: 2.5rem 1.75rem;
        }

        .auth-brand h1 {
            font-size: 2rem;
        }
    }
</style>

<div class="auth-page">
    <div class="auth-brand"><h1>Saudi Heritage</h1><p>Dunes of Arabia · Travel Platform</p></div>
    <div class="auth-card">
        <div class="success-icon">📬</div>
        <h2 class="card-title">Check Your Email</h2>

        @* ── DEV MODE: when no real email sender is configured, show the link directly ── *@
        @if (EmailSender is IdentityNoOpEmailSender && !string.IsNullOrEmpty(devResetLink))
        {
            <div class="dev-box">
                <strong>⚠️ Dev Mode – No real email sender configured</strong>
                Click the link below to reset your password (this would normally be emailed):<br /><br />
                <a href="@devResetLink">Reset my password →</a>
            </div>
        }
        else
        {
            <p class="card-body">
                We've sent a password reset link to your email address.
                Please check your inbox and click the link to continue.
            </p>
            <div class="info-box">
                <strong>Didn't receive it?</strong><br />
                Check your spam or junk folder. The link expires in <strong>24 hours</strong>.
                Make sure the address you entered is registered with us.
            </div>
        }

        <a href="/Account/Login" class="btn-primary">Back to Sign In</a>
        <div class="resend-link">
            Still no email? <a href="/Account/ResendEmailConfirmation">Resend confirmation</a>
        </div>
    </div>
</div>

@code {
    // NOTE: This page receives the email via query string when in dev mode so it can build the dev link.
    // In production the page just shows the "check your email" message regardless.
    private string? devResetLink;

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    // If both Email and Code are provided (passed from ForgotPassword in dev mode), build the link
    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Email) && !string.IsNullOrEmpty(Code))
        {
            devResetLink = NavigationManager.GetUriWithQueryParameters(
                NavigationManager.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
                new Dictionary<string, object?> { ["code"] = Code });
        }
    }
}