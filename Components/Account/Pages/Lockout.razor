@* =====================================================
   Lockout.razor
   Path: Components/Account/Pages/Lockout.razor
   ===================================================== *@
@page "/Account/Lockout"
@layout DunesOfArabia.Components.Layout.EmptyLayout

<PageTitle>Account Locked – Dunes Of Arabia</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap');

    *, *::before, *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .auth-page {
        min-height: 100vh;
        background: radial-gradient(ellipse at 60% 40%, #E8D9C5 0%, #DFD0B8 50%, #D4C4A8 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        font-family: 'Inter','Segoe UI',sans-serif;
    }

    .auth-brand {
        text-align: center;
        margin-bottom: 2rem;
    }

        .auth-brand h1 {
            font-family: 'Playfair Display',Georgia,serif;
            font-size: 2.6rem;
            font-weight: 700;
            color: #7B2D10;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: .4rem;
        }

        .auth-brand p {
            font-size: 1rem;
            color: #8B6650;
        }

    .auth-card {
        background: #FFFFFF;
        border-radius: 16px;
        padding: 3rem;
        width: 100%;
        max-width: 480px;
        box-shadow: 0 4px 40px rgba(100,50,20,.10);
        text-align: center;
    }

    .card-icon {
        font-size: 4rem;
        margin-bottom: 1.25rem;
    }

    .card-title {
        font-family: 'Playfair Display',Georgia,serif;
        font-size: 1.85rem;
        font-weight: 600;
        color: #1C0F07;
        margin-bottom: 1rem;
    }

    .card-body {
        font-size: .95rem;
        color: #5A3E30;
        line-height: 1.7;
        margin-bottom: 2rem;
    }

    .btn-primary {
        display: inline-block;
        padding: 13px 32px;
        background-color: #7B2D10;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: .95rem;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        text-decoration: none;
        transition: background-color .25s,transform .2s;
    }

        .btn-primary:hover {
            background-color: #5C2009;
            transform: translateY(-1px);
        }
</style>

<div class="auth-page">
    <div class="auth-brand"><h1>Saudi Heritage</h1><p>Dunes of Arabia · Travel Platform</p></div>
    <div class="auth-card">
        <div class="card-icon">🔐</div>
        <h2 class="card-title">Account Locked</h2>
        <p class="card-body">Your account has been temporarily locked due to too many failed login attempts. Please try again in a few minutes, or contact support if you need immediate assistance.</p>
        <a href="/Account/Login" class="btn-primary">Try Again</a>
    </div>
</div>